{
  "name": "@chest-backup/monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @chest-backup/api dev & pnpm --filter @chest-backup/web dev",
    "dev:api": "pnpm --filter @chest-backup/api dev",
    "dev:web": "pnpm --filter @chest-backup/web dev",
    "dev:tray": "pnpm --filter @chest-backup/tray dev",
    "build": "pnpm -r --filter '!@chest-backup/app' build",
    "build:api": "pnpm --filter @chest-backup/api build",
    "build:web": "pnpm --filter @chest-backup/web build",
    "build:tray": "pnpm --filter @chest-backup/tray build",
    "start": "pnpm --filter @chest-backup/app start",
    "start:tray": "pnpm --filter @chest-backup/tray start",
    "lint": "eslint apps/ src/",
    "typecheck": "tsc --noEmit",
    "release:patch": "npm version patch -m \"chore(release): v%s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"chore(release): v%s\" && git push --follow-tags",
    "release:major": "npm version major -m \"chore(release): v%s\" && git push --follow-tags"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cpu-features",
      "ssh2"
    ]
  }
}
