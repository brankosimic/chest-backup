{
  "name": "@chest-backup/tray",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --external cpu-features --external @trayjs/* && cp src/tray/icon_*.png dist/",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@chest-backup/core": "workspace:*",
    "@trayjs/trayjs": "^0.0.10"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
