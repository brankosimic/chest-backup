#!/usr/bin/bash
set -e

INSTALL_DIR="/usr/share/chest-backup"
API_PID=""

export CHEST_CONFIG_PATH="${CHEST_CONFIG_PATH:-$HOME/.config/chest-backup/chest-backup.json}"

cleanup() {
  [ -n "$API_PID" ] && kill "$API_PID" 2>/dev/null || true
}
trap cleanup EXIT
trap 'cleanup; exit 0' INT TERM

start_api() {
  /usr/bin/bun "$INSTALL_DIR/packages/api/dist/index.js" &
  API_PID=$!
}

start_api
echo "chest-backup: starting API server and daemon" >&2

wait "$API_PID"
