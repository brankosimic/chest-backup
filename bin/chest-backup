#!/usr/bin/bash
set -e

INSTALL_DIR="/usr/share/chest-backup"
API_PID=""
TRAY_PID=""
GRAPHICAL_SESSION=""

export CHEST_CONFIG_PATH="${CHEST_CONFIG_PATH:-$HOME/.config/chest-backup/chest-backup.json}"

MODE="auto"

if [ "${1:-}" = "--mode" ]; then
  MODE="$2"
fi

cleanup() {
  [ -n "$TRAY_PID" ] && kill "$TRAY_PID" 2>/dev/null || true
  [ -n "$API_PID" ] && kill "$API_PID" 2>/dev/null || true
}
trap cleanup EXIT
trap 'cleanup; exit 0' INT TERM

has_graphical_session() {
  for id in $(/usr/bin/loginctl list-sessions --no-legend 2>/dev/null | /usr/bin/awk '{print $1}'); do
    type=$(/usr/bin/loginctl show-session "$id" -p Type --value 2>/dev/null)
    if [ "$type" = x11 ] || [ "$type" = wayland ]; then
      GRAPHICAL_SESSION="$id"
      return 0
    fi
  done
  return 1
}

tray_available() {
  [ -d "$INSTALL_DIR/node_modules/@trayjs/trayjs" ] && ls "$INSTALL_DIR/node_modules/@trayjs"/linux-* >/dev/null 2>&1
}

start_api() {
  if [ "$1" = tray ]; then
    DAEMON_OWNER=tray /usr/bin/bun "$INSTALL_DIR/packages/api/dist/index.js" &
  else
    /usr/bin/bun "$INSTALL_DIR/packages/api/dist/index.js" &
  fi
  API_PID=$!
}

start_tray() {
  /usr/bin/bun "$INSTALL_DIR/packages/tray/dist/index.js" &
  TRAY_PID=$!
}

set_display() {
  if [ -n "${DISPLAY:-}" ]; then
    return
  fi
  display=$(/usr/bin/loginctl show-session "$GRAPHICAL_SESSION" -p Display --value 2>/dev/null) || true
  export DISPLAY="${display:-:0}"
}

run_tray=false

case "$MODE" in
  tray)
    run_tray=true
    ;;
  headless)
    run_tray=false
    ;;
  auto)
  has_graphical_session && tray_available && run_tray=true
  ;;
esac

if [ "$run_tray" = true ]; then
  has_graphical_session && set_display
  start_api tray
  start_tray
  echo "chest-backup: running with system tray" >&2
else
  start_api
  if [ "$MODE" = "auto" ]; then
    echo "chest-backup: running headless (no tray)" >&2
  else
    echo "chest-backup: running in $MODE mode" >&2
  fi
fi

if [ -n "$TRAY_PID" ]; then
  wait -n "$API_PID" "$TRAY_PID" 2>/dev/null
  exit $?
fi

wait "$API_PID"
