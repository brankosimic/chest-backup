[Unit]
Description=chest-backup - API server and backup daemon (with system tray)
After=network.target graphical-session.target
Wants=network.target graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/<project-path>
EnvironmentFile=%h/<project-path>/.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CHEST_CONFIG_PATH=%h/<project-path>/chest-backup.json
ExecStartPre=/usr/bin/sleep 5
ExecStart=%h/<project-path>/bin/chest-backup --mode tray
Restart=on-failure
RestartSec=30s
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes

[Install]
WantedBy=default.target
